{
    "name": "Islands Dark",
    "version": "1.0.0",
    "author": "Islands Dark Team",
    "description": "A dark color theme for code editors",
    "type": "dark",
    "colors": {
        "background": "#191A1C",
        "foreground": "#BCBEC4",
        "keyword": "#CF8E6D",
        "string": "#6AAB73",
        "number": "#2AACB8",
        "comment": "#7A7E85",
        "function": "#56A8F5",
        "constant": "#C77DBB",
        "preprocessor": "#B3AE60",
        "error": "#F75464",
        "typeParameter": "#16BAAC",
        "tag": "#D5B778",
        "entityReference": "#56A8F5",
        "docComment": "#5F826B"
    },
    "editor": {
        "fontFamily": "JetBrains Mono",
        "fontSize": 14,
        "lineHeight": 1.6,
        "tabSize": 4,
        "insertSpaces": true
    },
    "languages": [
        { "name": "Java", "extensions": [".java"], "enabled": true },
        { "name": "Python", "extensions": [".py"], "enabled": true },
        { "name": "JavaScript", "extensions": [".js", ".mjs"], "enabled": true },
        { "name": "Go", "extensions": [".go"], "enabled": true },
        { "name": "Rust", "extensions": [".rs"], "enabled": true }
    ],
    "tokens": {
        "keyword": { "foreground": "#CF8E6D", "fontStyle": "bold" },
        "string": { "foreground": "#6AAB73" },
        "number": { "foreground": "#2AACB8" },
        "comment": { "foreground": "#7A7E85", "fontStyle": "italic" },
        "function": { "foreground": "#56A8F5" }
    }
}